# Copia in .streamlit/secrets.toml (escluso da git) oppure incolla in Streamlit Cloud -> App -> Settings -> Secrets.
# La anon key di Supabase è pubblica per progetto: la protezione vera sono le regole RLS della migrazione.
SUPABASE_URL = "https://IL-TUO-PROGETTO.supabase.co"
SUPABASE_ANON_KEY = "incolla-la-anon-public-key"

# Facoltativo — provider AI per il planner di Guardian (API compatibili OpenAI: FreeLLMAPI, OpenRouter, Ollama, OpenAI…).
# Senza questi valori il planner resta "non disponibile"; report e prossime azioni funzionano comunque.
# GUARDIAN_PROVIDERS = "freellm"
# GUARDIAN_PROVIDER_FREELLM_URL = "https://il-tuo-gateway/v1"
# GUARDIAN_PROVIDER_FREELLM_MODEL = "nome-modello"
# GUARDIAN_PROVIDER_FREELLM_KEY = "chiave-del-gateway"
# GUARDIAN_PROVIDER_FREELLM_COSTO = "free"      # free | local | paid
# GUARDIAN_ALLOW_PAID = "0"                      # 1 = consenti provider a pagamento
