# Copia in dashboard/.env e adatta. Il file .env NON va committato.

# Sorgente dati: "local" (questo PC) oppure "remote" (agent HTTP di un collega)
GUARDIAN_SOURCE=local
GUARDIAN_AGENT_URL=
GUARDIAN_TOKEN=

# Percorsi
CLAUDE_HOME=~/.claude
CLAUDE_BIN=claude
GUARDIAN_EVENTS_FILE=~/.claude/guardian/events.jsonl
# Cartelle progetto proposte nella chat (separate da virgola); le altre si ricavano dalle sessioni
DEFAULT_PROJECTS=

# Intervalli (secondi)
REFRESH_S=3
IDLE_THRESHOLD_S=120
HISTORY_S=120
AGENT_MAX_AGE_H=24
CHAT_TIMEOUT_S=900

# Chat: default (chiede permessi: gli strumenti che li richiedono falliscono in -p),
# acceptEdits, plan, bypassPermissions (PERICOLOSO)
CHAT_PERMISSION_MODE=default

# Prezzi USD per milione di token (stima!), JSON opzionale:
# PRICES_JSON={"opus":[15,75],"sonnet":[3,15],"haiku":[1,5]}
PRICES_JSON=
