# Copia in bridge/.env (escluso da git). Mai committare il file .env.
GUARDIAN_SUPABASE_URL=https://IL-TUO-PROGETTO.supabase.co
GUARDIAN_SUPABASE_ANON_KEY=incolla-la-anon-public-key
# Token del PC: si genera in Guardian Hub -> Dispositivi -> Registra un PC (mostrato una sola volta)
GUARDIAN_DEVICE_TOKEN=
GUARDIAN_AGENT=Claude Code
GUARDIAN_MODEL=
# Agenti seguiti da questo PC (lasciare vuoto quello che non usi). Stato reale da hook/notify: vedi bridge/install_hooks.py
GUARDIAN_CLAUDE_AGENT_ID=
GUARDIAN_CODEX_AGENT_ID=
# Capacità dichiarate degli agenti di questo PC, separate da virgola (es. python,siti,test)
GUARDIAN_CAPABILITIES=
# 1 = nei log condivisi anche le richieste agli agenti troncate a 200 caratteri (senza segreti); 0 = solo metadati
GUARDIAN_SHARE_PROMPTS=1
